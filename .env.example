# Copy this file to ".env" and fill in real values.
# .env is never sent to the browser -- it is only read by the Flask backend.

# --- Router SSH connection ---
ROUTER_HOST=192.168.1.1
ROUTER_PORT=22
ROUTER_USERNAME=root

# Use EITHER a password OR a private key path (key is recommended).
ROUTER_PASSWORD=
ROUTER_KEY_PATH=

SSH_CONNECT_TIMEOUT=6
SSH_COMMAND_TIMEOUT=8

# --- Flask ---
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=False

# --- Polling ---
# How often the frontend polls the backend, in milliseconds.
REFRESH_INTERVAL_MS=5000

# How many CPU history samples to keep server-side for the chart.
CPU_HISTORY_LENGTH=60
